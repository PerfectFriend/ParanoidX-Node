[Unit]
Description=ParanoidX bridge (SimpleX Chat CLI gateway)
Documentation=https://stmaria.org
PartOf=ParanoidX.target
After=ParanoidX-dashboard.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
ExecStart=@HOME@/bin/simplex-bridge -data @HOME@/.local/share/ParanoidX
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=ParanoidX.target
