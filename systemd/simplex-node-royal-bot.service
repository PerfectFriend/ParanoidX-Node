[Unit]
Description=simplex-node Telegram royal public-services bot
After=network-online.target simplex-node-dashboard.service
Wants=network-online.target
PartOf=simplex-node.target

[Service]
Type=simple
User=tomas
Group=tomas
WorkingDirectory=%h/simplex-node
Environment=HOME=%h
Environment=USER=tomas
ExecStart=/usr/bin/python3 %h/simplex-node/scripts/telegram_royal_bot.py
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal

PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
NoNewPrivileges=true
ReadWritePaths=%h

[Install]
WantedBy=simplex-node.target
